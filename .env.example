# Copy to .env and adjust. All variables are prefixed RESUMEPILOT_ (see core/config.py).

RESUMEPILOT_APP_NAME="ResumePilot AI"
RESUMEPILOT_ENVIRONMENT=local
RESUMEPILOT_DEBUG=true

RESUMEPILOT_HOST=0.0.0.0
RESUMEPILOT_PORT=8000

RESUMEPILOT_LOG_LEVEL=INFO
RESUMEPILOT_LOG_JSON=true

RESUMEPILOT_CORS_ORIGINS=["*"]

# Multi-LLM Resilience: build_llm_gateway (gateways/llm/factory.py) wires
# these into an ordered fallback chain, logged once at startup and again
# on every request as "llm_provider_chain_configured". Primary is always
# tried first; secondary/tertiary are optional and only used if an
# earlier provider fails transiently (rate limit, timeout, 5xx) — see
# gateways/llm/chain.py. Valid provider names: "gemini", "openrouter",
# "mock". A provider named here with no matching API key below fails the
# app at startup, not silently.
RESUMEPILOT_PRIMARY_PROVIDER=mock
# RESUMEPILOT_SECONDARY_PROVIDER=mock
# RESUMEPILOT_TERTIARY_PROVIDER=mock

# Required only if "gemini" appears above. Get a key from https://aistudio.google.com/apikey
RESUMEPILOT_GEMINI_API_KEY=your-gemini-api-key-here
RESUMEPILOT_GEMINI_MODEL=gemini-2.5-flash

# Required only if "openrouter" appears above. Get a key from https://openrouter.ai/keys
RESUMEPILOT_OPENROUTER_API_KEY=your-openrouter-api-key-here
# Ordered list (JSON array, same syntax as RESUMEPILOT_CORS_ORIGINS above)
# of OpenRouter models to try, in order, on every call. OpenRouterGateway
# falls back to the next model on a timeout, HTTP 429, HTTP 5xx, an empty
# response, malformed JSON, or a schema-validation failure -- only once
# every model here has failed does GatewayChain move on to the next
# configured provider. Does NOT retry across models on an auth failure,
# bad request, or invalid API key -- those fail identically against every
# model. OpenRouter's free-tier catalog changes over time (models get
# retired) -- if one of these starts returning HTTP 404, check
# https://openrouter.ai/api/v1/models for a current ':free'-suffixed
# replacement. Avoid *reasoning* models (e.g. openai/gpt-oss-20b:free):
# under this app's long structured-output prompts, one was observed
# returning finish_reason=stop with an empty/null message.content --
# exactly the failure mode this list exists to route around, but still
# wasted latency if it's first in the list.
RESUMEPILOT_OPENROUTER_MODELS=["google/gemma-4-26b-a4b-it:free","qwen/qwen3-30b-a3b:free","meta-llama/llama-3.3-70b-instruct:free","deepseek/deepseek-chat:free"]
