# Copy to .env and adjust. All variables are prefixed RESUMEPILOT_ (see core/config.py).

RESUMEPILOT_APP_NAME="ResumePilot AI"
RESUMEPILOT_ENVIRONMENT=local
RESUMEPILOT_DEBUG=true

RESUMEPILOT_HOST=0.0.0.0
RESUMEPILOT_PORT=8000

RESUMEPILOT_LOG_LEVEL=INFO
RESUMEPILOT_LOG_JSON=true

RESUMEPILOT_CORS_ORIGINS=["*"]
